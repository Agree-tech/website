{
  "name": "agree-tech-cms",
  "version": "1.0.0",
  "description": "Payload CMS for the Agree Technologies site. Headless: it owns the content, the static build in ../ renders it.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-globals.mjs && node scripts/generate-blocks.mjs",
    "predev": "npm run generate",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "build": "npm run generate && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file=.env scripts/seed.ts && npm run seed:pages",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed:pages": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file=.env scripts/seed-pages.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
