# Local Postgres from docker-compose.yml (`docker compose up -d`).
#
# Not SQLite: Payload stores a global's fields as columns on one table, and the
# homepage has 183 of them. Reading it builds a json_array() with an argument
# per column, which SQLite caps at 127 — compiled into the driver, not a
# setting. Point this at a hosted instance to deploy.
DATABASE_URI=postgres://payload:payload@localhost:5433/agree_tech_cms
PAYLOAD_SECRET=change-me-before-anything-real
